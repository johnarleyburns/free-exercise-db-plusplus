{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/johnarleyburns/free-exercise-db-plusplus/main/exercise-interop-mapping.schema.json",
  "title": "DB++ Exercise Identity Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingKind",
    "target",
    "mappingVersion",
    "status",
    "targetSpecification",
    "entries"
  ],
  "properties": {
    "mappingKind": {
      "const": "identity"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mappingVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "draft-reviewed",
        "stable",
        "placeholder"
      ]
    },
    "targetSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "reviewedOn",
        "references"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "externalName",
        "dbppExerciseIds",
        "relation",
        "direction",
        "confidence",
        "provenance"
      ],
      "properties": {
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "externalName": {
          "type": "string",
          "minLength": 1
        },
        "dbppExerciseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relation": {
          "enum": [
            "exact",
            "close",
            "broader",
            "narrower",
            "approximate",
            "unmapped"
          ]
        },
        "direction": {
          "enum": [
            "external_to_dbpp",
            "dbpp_to_external",
            "bidirectional"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "rationale"
          ],
          "properties": {
            "source": {
              "type": "string",
              "format": "uri"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "unmapped"
              }
            }
          },
          "then": {
            "properties": {
              "dbppExerciseIds": {
                "maxItems": 0
              },
              "direction": {
                "not": {
                  "const": "bidirectional"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation": {
                "enum": [
                  "exact",
                  "close",
                  "broader",
                  "narrower",
                  "approximate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "dbppExerciseIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
