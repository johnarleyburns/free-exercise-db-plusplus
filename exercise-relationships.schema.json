{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/johnarleyburns/free-exercise-db-plusplus/main/exercise-relationships.schema.json",
  "title": "Free Exercise DB++ Exercise Relationships",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "families", "relationships"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["artifact", "projectRelease", "sourceExerciseCount", "generator", "sourceSha256", "relationshipVocabulary", "dimensionVocabulary", "semanticNotice"], "properties": {"artifact": {"const": "exercise-relationships"}, "projectRelease": {"type": "string"}, "sourceDatabaseSchemaVersion": {"type": "string"}, "sourceExerciseCount": {"type": "integer", "minimum": 0}, "generator": {"type": "string", "minLength": 1}, "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "relationshipVocabulary": {"type": "array", "items": {"$ref": "#/$defs/relationship"}, "uniqueItems": true}, "dimensionVocabulary": {"type": "array", "items": {"$ref": "#/$defs/dimensionName"}, "uniqueItems": true}, "semanticNotice": {"type": "string", "minLength": 1}}},
    "families": {"type": "object", "propertyNames": {"$ref": "#/$defs/familyId"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["familyId", "name", "aliases"], "properties": {"familyId": {"$ref": "#/$defs/familyId"}, "name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}},
    "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sourceExerciseId", "familyId", "relationship", "dimensions", "confidence", "provenance"], "properties": {"sourceExerciseId": {"type": "string", "minLength": 1}, "targetExerciseId": {"type": "string", "minLength": 1}, "familyId": {"$ref": "#/$defs/familyId"}, "relationship": {"$ref": "#/$defs/relationship"}, "dimensions": {"type": "object", "additionalProperties": false, "properties": {"equipment": {"type": "string", "minLength": 1}, "grip": {"enum": ["close", "wide", "neutral", "reverse", "mixed", "pronated", "supinated"]}, "stance": {"enum": ["wide", "narrow", "sumo", "split"]}, "angle": {"enum": ["flat", "incline", "decline"]}, "laterality": {"enum": ["unilateral", "bilateral"]}, "body_position": {"enum": ["standing", "seated", "lying", "kneeling"]}, "load_position": {"enum": ["front", "overhead", "zercher", "goblet"]}, "assistance": {"enum": ["reverse_band", "assisted"]}, "resistance_type": {"enum": ["bands", "chains"]}}}, "confidence": {"enum": ["high", "medium"]}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "source", "rationale"], "properties": {"type": {"enum": ["rule", "manual_review", "source_taxonomy", "name_normalization"]}, "source": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}}}}, "allOf": [{"if": {"properties": {"relationship": {"const": "member_of_family"}}}, "then": {"not": {"required": ["targetExerciseId"]}}, "else": {"required": ["targetExerciseId"]}}]}}
  },
  "$defs": {"familyId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}, "relationship": {"enum": ["member_of_family", "variation_of", "equipment_variant_of", "grip_variant_of", "stance_variant_of", "angle_variant_of", "laterality_variant_of"]}, "dimensionName": {"enum": ["equipment", "grip", "stance", "angle", "laterality", "body_position", "load_position", "assistance", "resistance_type"]}}
}
