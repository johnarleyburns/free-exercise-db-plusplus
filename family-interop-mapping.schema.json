{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/johnarleyburns/free-exercise-db-plusplus/main/family-interop-mapping.schema.json",
  "title": "DB++ Family Interoperability Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingKind", "target", "mappingVersion", "status", "targetSpecification", "entries"],
  "properties": {
    "mappingKind": {"const": "family"}, "target": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "mappingVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "status": {"enum": ["draft-reviewed", "stable"]},
    "targetSpecification": {"type": "object", "additionalProperties": false, "required": ["name", "version", "reviewedOn", "references"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "reviewedOn": {"type": "string", "format": "date"}, "references": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}}},
    "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["externalId", "externalName", "familyId", "relation", "direction", "confidence", "provenance"], "properties": {"externalId": {"type": "string", "minLength": 1}, "externalName": {"type": "string", "minLength": 1}, "familyId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}, "relation": {"enum": ["broader", "exact", "approximate"]}, "direction": {"enum": ["external_to_dbpp", "dbpp_to_external", "bidirectional"]}, "confidence": {"enum": ["high", "medium"]}, "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "rationale"], "properties": {"source": {"type": "string", "format": "uri"}, "rationale": {"type": "string", "minLength": 1}}}}}}
  }
}
