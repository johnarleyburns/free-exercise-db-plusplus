{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/johnarleyburns/free-exercise-db-plusplus/main/interop-mapping.schema.json",
  "title": "Free Exercise DB++ Interoperability Mapping Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "mappingKind",
    "mappingVersion",
    "sourceArtifact",
    "status",
    "target",
    "targetSpecification"
  ],
  "properties": {
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mappingVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "placeholder",
        "draft-reviewed",
        "stable"
      ]
    },
    "targetSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "reviewedOn",
        "references"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "sourceArtifact": {
      "type": "string",
      "enum": [
        "exercise-db",
        "workout-actual",
        "workout-plan"
      ]
    },
    "mappingKind": {
      "type": "string",
      "enum": [
        "field",
        "structural",
        "category"
      ]
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "targetField",
        "quality",
        "transform",
        "notes"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "targetMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetType": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetField": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "exact",
            "compatible",
            "lossy",
            "extension_required",
            "unsupported"
          ]
        },
        "transform": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "external_to_dbpp",
            "dbpp_to_external",
            "bidirectional"
          ]
        },
        "lossStatus": {
          "type": "string",
          "enum": [
            "informational",
            "lossy",
            "unsupported",
            "invalid"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "targetMessage"
          ]
        },
        {
          "required": [
            "targetType"
          ]
        }
      ]
    }
  }
}
