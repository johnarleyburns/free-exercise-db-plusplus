{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interop loss report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "losses"
  ],
  "properties": {
    "status": {
      "enum": [
        "informational",
        "lossless",
        "normalized",
        "lossy",
        "unsupported",
        "invalid"
      ]
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "normalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
