    {"id":"Standing_Toe_Raise","name":"Standing Toe Raise","equipment":"body only","force":"pull","mechanic":"isolation","level":"beginner","patterns":["dorsiflexion"],"direct":["tibialis"],"indirect":[],"stabilizers":[],"family":"tibialis_raise","aliases":["Bodyweight Tibialis Raise","Toe Raise"],"vendors":[],"sourceRefs":["nhs_toe_raise","nhs_strength_balance_toe_raise"],"instructions":["Stand beside a stable support with your heels on the ground.","Lift the forefeet toward the shins without lifting the heels or curling the toes.","Lower the forefeet slowly; keep your body controlled."]},
    {"id":"Band_Ankle_Dorsiflexion","name":"Band-Resisted Ankle Dorsiflexion","equipment":"bands","force":"pull","mechanic":"isolation","level":"beginner","patterns":["dorsiflexion"],"direct":["tibialis"],"indirect":[],"stabilizers":[],"family":"tibialis_raise","aliases":["Banded Tibialis Raise","Resisted Dorsiflexion"],"vendors":[],"sourceRefs":["aaos_ankle_conditioning"],"instructions":["Sit with your heel supported and anchor a band in front of the foot.","Secure the band across the forefoot so it resists lifting the foot toward the shin.","Pull the forefoot back without moving the knee, then return slowly."]},
    {"id":"Seated_Tib_Bar_Raise","name":"Seated Tib-Bar Raise","equipment":"other","force":"pull","mechanic":"isolation","level":"beginner","patterns":["dorsiflexion"],"direct":["tibialis"],"indirect":[],"stabilizers":[],"family":"tibialis_raise","aliases":["Tib Bar Raise","Bilateral Tibialis Raise"],"vendors":[],"sourceRefs":["tib_bar_manufacturer"],"instructions":["Sit on a stable bench with your lower legs supported and feet beyond its edge.","Secure both feet in a tib bar loaded within the equipment rating.","Lift the forefeet toward the shins and lower the load under control."]},
    {"id":"Single-Leg_Tib_Bar_Raise","name":"Single-Leg Tib-Bar Raise","equipment":"other","force":"pull","mechanic":"isolation","level":"beginner","patterns":["dorsiflexion"],"direct":["tibialis"],"indirect":[],"stabilizers":[],"family":"tibialis_raise","aliases":["Unilateral Tibialis Raise","Solo Tib-Bar Raise"],"vendors":[],"sourceRefs":["tib_bar_manufacturer"],"instructions":["Sit with one lower leg supported and its foot beyond the bench edge.","Secure that foot in a unilateral tib bar and choose a controllable load.","Raise the forefoot toward the shin, lower slowly, and repeat on the other side."]},
    {"id":"Seated_Hip_Flexion","name":"Seated Hip Flexion","equipment":"body only","force":"pull","mechanic":"isolation","level":"beginner","patterns":["hip_flexion"],"direct":["hip_flexors"],"indirect":[],"stabilizers":[],"family":"hip_flexion","aliases":["Seated March"],"vendors":[],"sourceRefs":["osu_iliopsoas_progression","uw_seated_hip_flexion"],"instructions":["Sit upright on a firm seat with both knees bent and feet supported.","Lift one bent knee without leaning the trunk backward or rotating the pelvis.","Lower slowly and alternate sides."]},
    {"id":"Supine_Short-Lever_Hip_Flexion","name":"Supine Short-Lever Hip Flexion","equipment":"body only","force":"pull","mechanic":"isolation","level":"beginner","patterns":["hip_flexion"],"direct":["hip_flexors"],"indirect":[],"stabilizers":[],"family":"hip_flexion","aliases":["Supine Bent-Knee March"],"vendors":[],"sourceRefs":["osu_iliopsoas_progression"],"instructions":["Lie on your back with knees bent and feet supported.","Keep one knee bent while bringing it toward the torso without rocking the pelvis.","Lower that foot slowly before changing sides."]},
    {"id":"Standing_Hip_Flexion_Hold","name":"Standing Hip-Flexion Hold","equipment":"body only","force":"pull","mechanic":"isolation","level":"beginner","patterns":["hip_flexion"],"direct":["hip_flexors"],"indirect":[],"stabilizers":[],"family":"hip_flexion","aliases":["Standing Knee-Raise Hold"],"vendors":[],"sourceRefs":["cuh_hip_flexion"],"instructions":["Stand upright beside a stable support.","Raise one bent knee to a comfortable height while keeping the pelvis level.","Hold against gravity without leaning, then lower slowly and change sides."]},
    {"id":"Resisted_Neck_Rotation_Isometric","name":"Resisted Neck Rotation Isometric","equipment":"body only","force":"pull","mechanic":"isolation","level":"beginner","patterns":["neck_rotation"],"direct":["neck"],"indirect":[],"stabilizers":[],"family":"neck_conditioning","aliases":["Isometric Cervical Rotation","Hand-Resisted Neck Rotation"],"vendors":[],"sourceRefs":["nhs_resisted_neck_rotation"],"instructions":["Sit upright with your head facing forward and place a hand against the side of your face.","Attempt to turn the head gently into the hand while the hand prevents movement.","Release gradually and repeat on the opposite side without forcing the neck."]},
    {"id":"Band_External_Rotation_90_Abduction","name":"Band External Rotation at 90 Degrees Abduction","equipment":"bands","force":"pull","mechanic":"isolation","level":"beginner","patterns":["shoulder_external_rotation"],"direct":["rotator_cuff"],"indirect":[],"stabilizers":[],"family":"shoulder_rotation","aliases":["90/90 Band External Rotation"],"vendors":[],"sourceRefs":["aaos_rotator_cuff_conditioning"],"instructions":["Anchor a light band in front of you and hold the upper arm at shoulder height with the elbow bent.","Keep the upper arm and elbow level while rotating the forearm upward against resistance.","Return slowly without arching the back or moving the elbow."]},
    {"id":"Side-Lying_Dumbbell_Internal_Rotation","name":"Side-Lying Dumbbell Internal Rotation","equipment":"dumbbell","force":"pull","mechanic":"isolation","level":"beginner","patterns":["shoulder_internal_rotation"],"direct":["rotator_cuff"],"indirect":[],"stabilizers":[],"family":"shoulder_rotation","aliases":["Lying Dumbbell Internal Rotation"],"vendors":[],"sourceRefs":["aaos_rotator_cuff_conditioning"],"instructions":["Lie on the exercising side with the upper arm beside the torso and elbow bent.","Hold a light dumbbell in the lower hand and rotate the forearm toward the torso while keeping the elbow stationary.","Lower the forearm slowly without rolling the trunk."]},
    {"id":"Supine_Dumbbell_Shoulder_Rotation","name":"Supine Dumbbell Shoulder Rotation","equipment":"dumbbell","force":"pull","mechanic":"isolation","level":"beginner","patterns":["shoulder_internal_rotation","shoulder_external_rotation"],"direct":["rotator_cuff"],"indirect":[],"stabilizers":[],"family":"shoulder_rotation","aliases":["Supine Internal and External Rotation"],"vendors":[],"sourceRefs":["aaos_rotator_cuff_conditioning"],"instructions":["Lie on your back with the upper arm supported out to the side and elbow bent.","With a light dumbbell, rotate the forearm through a comfortable internal and external rotation arc.","Keep the elbow supported and control both directions without forcing the shoulder."]}
