{
  "schemaVersion": "0.1.0",
  "defaultLocale": "en",
  "supportedLocales": [
    "en",
    "es",
    "de",
    "zh-Hans",
    "zh-Hant",
    "pt-BR",
    "fr",
    "ja"
  ],
  "fallbackPolicy": "locale -> base language -> en",
  "catalogs": {
    "es": "translations/es.json",
    "de": "translations/de.json",
    "zh-Hans": "translations/zh-Hans.json",
    "zh-Hant": "translations/zh-Hant.json",
    "pt-BR": "translations/pt-BR.json",
    "fr": "translations/fr.json",
    "ja": "translations/ja.json"
  }
}
