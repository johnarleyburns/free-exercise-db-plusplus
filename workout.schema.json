{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/johnarleyburns/free-exercise-db-plusplus/main/workout.schema.json",
  "title": "Free Exercise DB++ Workout Interchange",
  "description": "Portable resistance-training observations. Exercise definitions remain separate and are referenced by exerciseId when available.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "startTime", "exercises"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.2.0"},
    "sessionId": {"type": "string", "minLength": 1},
    "athleteId": {"type": ["string", "null"]},
    "programId": {"type": ["string", "null"]},
    "programDayId": {"type": ["string", "null"]},
    "coachId": {"type": ["string", "null"]},
    "startTime": {"type": "string", "format": "date-time"},
    "endTime": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "tags": {"type": ["array", "null"], "items": {"type": "string"}, "uniqueItems": true},
    "source": {"$ref": "#/$defs/provenance"},
    "device": {"$ref": "#/$defs/device"},
    "software": {"type": ["string", "null"]},
    "exercises": {"type": "array", "items": {"$ref": "#/$defs/exerciseObservation"}}
  },
  "$defs": {
    "quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}}},
    "externalExerciseId": {"type": "object", "additionalProperties": false, "required": ["system", "value"], "properties": {"system": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}},
    "provenance": {"type": ["object", "null"], "additionalProperties": false, "required": ["system", "recordId"], "properties": {"system": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]}, "recordId": {"type": "string", "minLength": 1}}},
    "device": {"type": ["object", "null"], "additionalProperties": false, "properties": {"manufacturer": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}}},
    "structure": {"type": ["object", "null"], "additionalProperties": false, "required": ["groupId", "groupType"], "properties": {"groupId": {"type": "string", "minLength": 1}, "groupType": {"type": "string", "enum": ["superset", "tri_set", "giant_set", "circuit", "complex", "paired"]}, "round": {"type": ["integer", "null"], "minimum": 1}}},
    "resistance": {"type": ["object", "null"], "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"type": "string", "enum": ["external_load", "bodyweight", "bodyweight_plus_load", "assisted_bodyweight", "band", "machine_setting", "unknown"]}, "externalLoad": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "assistance": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "value": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]}, "band": {"type": ["object", "null"], "additionalProperties": false, "properties": {"manufacturer": {"type": ["string", "null"]}, "label": {"type": ["string", "null"]}, "nominalResistance": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}}}}},
    "exerciseObservation": {"type": "object", "additionalProperties": false, "required": ["order", "sets"], "properties": {"exerciseId": {"type": ["string", "null"], "minLength": 1}, "exerciseName": {"type": ["string", "null"], "minLength": 1}, "externalExerciseId": {"oneOf": [{"$ref": "#/$defs/externalExerciseId"}, {"type": "null"}]}, "variation": {"type": ["string", "null"]}, "equipment": {"type": ["string", "null"]}, "order": {"type": "integer", "minimum": 1}, "laterality": {"type": "string", "enum": ["bilateral", "left", "right", "alternating", "unspecified"]}, "notes": {"type": ["string", "null"]}, "tags": {"type": ["array", "null"], "items": {"type": "string"}, "uniqueItems": true}, "structure": {"$ref": "#/$defs/structure"}, "sets": {"type": "array", "items": {"$ref": "#/$defs/setObservation"}}}, "anyOf": [{"required": ["exerciseId"], "properties": {"exerciseId": {"type": "string"}}}, {"required": ["exerciseName"]}]},
    "segment": {"type": "object", "additionalProperties": false, "required": ["reps"], "properties": {"reps": {"type": "integer", "minimum": 0}, "load": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "duration": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "restAfter": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "laterality": {"type": ["string", "null"], "enum": ["bilateral", "left", "right", "alternating", "unspecified", null]}, "completed": {"type": "boolean"}}},
    "setObservation": {"type": "object", "additionalProperties": false, "required": ["setNumber", "setType", "completed"], "properties": {"setNumber": {"type": "integer", "minimum": 1}, "setType": {"type": "string", "enum": ["warmup", "working", "backoff", "drop", "amrap", "technique", "test", "isometric", "cluster", "rest_pause", "assisted", "other"]}, "reps": {"type": ["integer", "null"], "minimum": 0}, "load": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "duration": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "distance": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "resistance": {"$ref": "#/$defs/resistance"}, "laterality": {"type": ["string", "null"], "enum": ["bilateral", "left", "right", "alternating", "unspecified", null]}, "rpe": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "rir": {"type": ["number", "null"], "minimum": 0}, "tempo": {"type": ["string", "null"]}, "restAfter": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "toFailure": {"type": ["boolean", "null"]}, "assistance": {"type": ["string", "null"]}, "completed": {"type": "boolean"}, "notes": {"type": ["string", "null"]}, "segments": {"type": ["array", "null"], "minItems": 1, "items": {"$ref": "#/$defs/segment"}}, "meanVelocity": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "peakVelocity": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "repetitions": {"type": ["array", "null"], "items": {"$ref": "#/$defs/repObservation"}}}},
    "repObservation": {"type": "object", "additionalProperties": false, "required": ["repNumber"], "properties": {"repNumber": {"type": "integer", "minimum": 1}, "duration": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "rangeOfMotion": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "meanVelocity": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "peakVelocity": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]}, "completed": {"type": ["boolean", "null"]}, "notes": {"type": ["string", "null"]}}}
  }
}
